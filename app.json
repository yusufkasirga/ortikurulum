{
  "expo": {
    "name": "Orti",
    "slug": "orti",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.orti.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Masadaki QR kodu okutup check-in yapmak ve kimlik doğrulaması için kamera kullanılır.",
        "NSLocationWhenInUseUsageDescription": "Yakındaki masaları göstermek ve mekâna vardığında check-in yapabilmek için konumun kullanılır."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5B3FE6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.orti.mobile",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#FFFFFF",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#401FE2"
        }
      ]
    ],
    "scheme": "orti",
    "owner": "mirrormedya",
    "extra": {
      "eas": {
        "projectId": "dc3e923d-b379-4e6a-aedd-c09f9665cfd7"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/dc3e923d-b379-4e6a-aedd-c09f9665cfd7",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}